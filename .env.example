# ==============================================================================
# EduTutor Pro — Environment Configuration Template
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings

# Database Configuration (PostgreSQL in production, defaults to SQLite if empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=edututor_db
DB_USER=edututor_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Settings (Background Tasks, Lead Alerts, Scheduled Reminders)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Email Service Configuration (SMTP / SendGrid / SES)
EMAIL_BACKEND=django.core.mail.backends.console.email.backend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=EduTutor Pro <noreply@edututorpro.com>

# Payment Gateway Configuration (Razorpay / Stripe / UPI)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

STRIPE_PUBLISHABLE_KEY=pk_test_YourStripePublishableKey
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKey
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSecret

# SMS & WhatsApp Gateway Configuration (Twilio / Gupshup / Fast2SMS)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_SENDER_NUMBER=whatsapp:+1234567890

# Static & Media Storage (AWS S3 / Google Cloud Storage / Local)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
